*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables and local secrets
.env
.env.*
!.env.example

# Hugging Face and model caches
.cache/
huggingface/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Training outputs and logs
outputs/*
!outputs/.gitkeep
logs/
runs/
wandb/

# Temporary files
*.tmp
*.temp
*.log
